RELIAFORGE_ENVIRONMENT=development
RELIAFORGE_HOST=127.0.0.1
RELIAFORGE_PORT=8000
RELIAFORGE_AUTH_MODE=development
RELIAFORGE_CORS_ORIGINS=["http://127.0.0.1:5530"]
RELIAFORGE_PLUGIN_OPERATION_TIMEOUT_SECONDS=10
RELIAFORGE_APP_STARTUP_TIMEOUT_SECONDS=30
RELIAFORGE_SHUTDOWN_TIMEOUT_SECONDS=10
# For proxy mode, replace this placeholder through your deployment secret store.
RELIAFORGE_PROXY_SHARED_SECRET=replace-with-a-random-value
RELIAFORGE_PROXY_TRUSTED_NETWORKS=["127.0.0.0/8"]
